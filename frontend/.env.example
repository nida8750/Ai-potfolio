# Copy to .env.local and fill in the values you actually have.
# Never commit real credentials. Every name without the NEXT_PUBLIC_ prefix is
# server-only and must never be read from browser code.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:43127

# Signs the session cookie. Use at least 32 random characters.
# Required in production; a development fallback is used otherwise.
SESSION_SECRET=

# Currency handling. Amounts are never converted between currencies.
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,PKR,AED,CAD,AUD

# Raises API request quotas for local test runs. Ignored when APP_ENV is
# production, where the configured limits always apply.
RATE_LIMIT_MULTIPLIER=1

# ---------------------------------------------------------------------------
# Data store
# auto     — Supabase when URL + anon + service_role are real; otherwise local
# local    — ./.data file store
# supabase — same as auto, but logs that keys were requested
# dynamodb — requires the AWS values below
# ---------------------------------------------------------------------------
DATA_STORE=auto

# ---------------------------------------------------------------------------
# Supabase (project ref wpdslwonqowelbrublju)
# The service role and DATABASE_URL are server-only. Never prefix them with
# NEXT_PUBLIC_. A blank password or the placeholder [YOUR-PASSWORD] is not a
# live connection — the app stays on the local file store until real keys
# are present.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://wpdslwonqowelbrublju.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:@db.wpdslwonqowelbrublju.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=assets

# ---------------------------------------------------------------------------
# AWS
# Prefer an IAM role on the runtime. Only set static keys where roles are not
# available, and never commit them.
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

DYNAMODB_TABLE_NAME=

S3_BUCKET_NAME=

# ---------------------------------------------------------------------------
# n8n automation
# The browser never calls n8n directly; requests are signed server-side.
# ---------------------------------------------------------------------------
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Payments
# Leave empty to keep checkout disabled. Provider availability differs by
# country, so choose per deployment.
# PAYMENT_PROVIDER: stripe | paypal | none
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=none

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
